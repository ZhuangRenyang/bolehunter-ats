# BoleHunter Docker Compose 环境变量（复制为 .env 后按需修改，.env 不入库）
# 数据库 root 密码（MySQL 初始化后修改需同步改 backend）
DB_PASSWORD=bolehunter2026
# JWT 签名密钥：生产必须替换为强随机值（>=64 字符）
# 生成示例：openssl rand -hex 32
JWT_SECRET=please-change-this-to-a-random-64-char-secret-in-production-0123456789abcdef
# 前端访问地址（CORS 白名单，逗号分隔）
CORS_ORIGINS=http://localhost:8080
# 前端对外端口
FRONTEND_PORT=8080
# 后台一键升级（迭代26）：关闭则"系统升级"页只读（迁移仍会在新版本启动时自动执行）
UPGRADE_ENABLED=true

# ---------- 镜像源（迭代28 国内一键部署）----------
# 默认（国际版）：backend/frontend 走 GHCR，mysql/redis 走 Docker Hub，无需配置以下变量。
# 国内部署：bash deploy-cn.sh 会在生成 .env 时自动写入下面四个变量，指向阿里云 ACR 国内源；
# 想自建/换源时手动改这四行即可。
# BACKEND_IMAGE=ghcr.io/zhuangrenyang/bolehunter-backend:latest
# FRONTEND_IMAGE=ghcr.io/zhuangrenyang/bolehunter-frontend:latest
# MYSQL_IMAGE=mysql:8.4
# REDIS_IMAGE=redis:7-alpine
